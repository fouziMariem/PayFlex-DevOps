{
  "info": {
    "name": "PayFlex API Integration Tests",
    "description": "Tests d'intégration HTTP de l'API PayFlex",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    }
  ],
  "item": [
    {
      "name": "1 - Home endpoint",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Welcome message is correct', function () {",
              "    pm.expect(pm.response.json().message).to.eql('Welcome to PayFlex API');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2 - Health endpoint",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('API is healthy', function () {",
              "    pm.expect(pm.response.json().status).to.eql('healthy');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3 - Get account balance",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/accounts/123/balance"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Initial balance is 1000', function () {",
              "    pm.expect(pm.response.json().balance).to.eql(1000);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4 - Unknown account",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/accounts/999/balance"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Unknown account returns 404', function () {",
              "    pm.response.to.have.status(404);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5 - Insufficient balance",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"account_id\":\"123\",\"amount\":2000}"
        },
        "url": "{{baseUrl}}/payments"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Insufficient balance returns 400', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test('Error message is correct', function () {",
              "    pm.expect(pm.response.json().detail).to.eql('Insufficient balance');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6 - Successful payment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"account_id\":\"123\",\"amount\":100}"
        },
        "url": "{{baseUrl}}/payments"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Payment succeeds with status 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Remaining balance is 900', function () {",
              "    pm.expect(pm.response.json().remaining_balance).to.eql(900);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "7 - Verify updated balance",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/accounts/123/balance"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Updated balance is 900', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().balance).to.eql(900);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
